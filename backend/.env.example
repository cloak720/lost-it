# Copy this file to .env and fill in your own values.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=lost_it

# Any long random string (used to sign login tokens)
SECRET_KEY=change-this-to-a-long-random-string-of-32-plus-characters

# The admin account that `python seed.py` creates (or updates)
ADMIN_NAME=admin1
ADMIN_EMAIL=admin1@campus.edu
ADMIN_PASSWORD=choose-a-strong-admin-password
